# Copiar a .env dentro de backend-core/ para correr con `uvicorn app.main:app --reload`
# fuera de docker-compose (ej. contra un Postgres local en localhost, o contra
# Supabase/Neon en produccion).

DATABASE_URL=postgresql+psycopg://parqueadero:parqueadero@localhost:5432/parqueadero
SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_VISION_URL=http://localhost:8001
CORS_ORIGINS=["http://localhost:5173"]

# Autorregistro de estudiantes
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
UNIVERSIDAD_NOMBRE=Universidad Francisco de Paula Santander
UNIVERSIDAD_DOMINIOS_CORREO=["ufps.edu.co"]
