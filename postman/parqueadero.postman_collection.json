    {
      "name": "06 - Accesos (reglas de negocio)",
      "item": [
        {
          "name": "RN-03: visitante sin justificación (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/accesos/entrada",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculo_id\": \"{{vehiculo2_id}}\",\n  \"zona_id\": \"{{zona_id}}\",\n  \"tipo_acceso\": \"visitante\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "RN-01: registrar entrada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/accesos/entrada",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculo_id\": \"{{vehiculo_id}}\",\n  \"zona_id\": \"{{zona_id}}\",\n  \"espacio_id\": \"{{espacio_id}}\",\n  \"tipo_acceso\": \"normal\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
