    {
      "name": "02 - Usuarios",
      "item": [
        {
          "name": "Mi perfil (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/usuarios/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Rol admin\", () => pm.expect(json.rol).to.eql(\"admin\"));",
                  "pm.collectionVariables.set(\"admin_id\", json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_completo\": \"Usuario Postman\",\n  \"correo_institucional\": \"{{nuevo_correo}}\",\n  \"documento_identidad\": \"{{nuevo_documento}}\",\n  \"telefono\": \"3001234567\",\n  \"rol\": \"estudiante\",\n  \"password\": \"postman123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo y documento son UNIQUE: se generan distintos en cada ejecución.",
                  "const n = Date.now();",
                  "pm.collectionVariables.set(\"nuevo_correo\", `postman${n}@uni.edu.co`);",
                  "pm.collectionVariables.set(\"nuevo_documento\", `${n}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Correo guardado\", () => pm.expect(json.correo_institucional).to.eql(pm.collectionVariables.get(\"nuevo_correo\")));",
                  "pm.test(\"No expone la contraseña\", () => pm.expect(json).to.not.have.property(\"hashed_password\"));",
                  "pm.collectionVariables.set(\"nuevo_usuario_id\", json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener usuario por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/usuarios/{{nuevo_usuario_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mismo id\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"nuevo_usuario_id\")));"
                ]
              }
            }
          ]
        },
