    {
      "name": "05 - Vehículos",
      "item": [
        {
          "name": "Registrar vehículo 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/vehiculos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{placa_1}}\",\n  \"tipo_vehiculo\": \"carro\",\n  \"marca\": \"Mazda\",\n  \"modelo\": \"2\",\n  \"color\": \"Rojo\",\n  \"usuario_id\": \"{{nuevo_usuario_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La placa es UNIQUE (máx. 10 caracteres): se generan dos placas nuevas por ejecución.",
                  "// Un vehículo debe tener dueño (usuario_id) o ser visitante: este es del usuario creado en 02.",
                  "const s = String(Date.now()).slice(-6);",
                  "pm.collectionVariables.set(\"placa_1\", `PA${s}`);",
                  "pm.collectionVariables.set(\"placa_2\", `PB${s}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Placa en mayúsculas\", () => pm.expect(json.placa).to.eql(pm.collectionVariables.get(\"placa_1\")));",
                  "pm.collectionVariables.set(\"vehiculo_id\", json.id);"
                ]
              }
            }
          ]
        },
