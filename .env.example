# Copiar a .env en la raiz del repo. docker-compose lo carga automaticamente para
# sustituir las variables ${...} usadas en docker-compose.yml.

POSTGRES_USER=parqueadero
POSTGRES_PASSWORD=parqueadero
POSTGRES_DB=parqueadero
POSTGRES_PORT=5432
PARQUEADERO_DB_PORT=5434
IDENTIDAD_DB_PORT=5435

SECRET_KEY=cambiar-esta-clave-en-produccion
CORS_ORIGINS=["http://localhost:5173"]

# Siembra de identidad (docker compose exec backend-identidad python -m app.db.seed).
# Las contrasenas de abajo son de relleno y el script las rechaza: exige minimo 12 caracteres.
SEED_ADMIN_CORREO=admin@uni.edu.co
SEED_ADMIN_PASSWORD=CAMBIAME
SEED_VIGILANTE_CORREO=vigilante@uni.edu.co
SEED_VIGILANTE_PASSWORD=CAMBIAME

GATEWAY_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173

CONFIANZA_MINIMA_ALPR=0.5

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/zonas
