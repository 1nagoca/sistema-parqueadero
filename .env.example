# Copiar a .env en la raiz del repo. docker-compose lo carga automaticamente para
# sustituir las variables ${...} usadas en docker-compose.yml.

POSTGRES_USER=parqueadero
POSTGRES_PASSWORD=parqueadero
POSTGRES_DB=parqueadero
POSTGRES_PORT=5432
PARQUEADERO_DB_PORT=5434

SECRET_KEY=cambiar-esta-clave-en-produccion
CORS_ORIGINS=["http://localhost:5173"]

GATEWAY_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173

CONFIANZA_MINIMA_ALPR=0.5

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/zonas
