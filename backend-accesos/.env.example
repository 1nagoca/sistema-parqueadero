# Copiar a .env dentro de backend-accesos/ para correr con `uvicorn app.main:app --reload`
# fuera de docker-compose (ej. contra un Postgres local en localhost, o contra
# Supabase/Neon en produccion).

DATABASE_URL=postgresql+psycopg://parqueadero:parqueadero@localhost:5433/parqueadero
SECRET_KEY=cambiar-esta-clave-en-produccion
# Clave entre servicios para /interno (encabezado X-Clave-Interna): en produccion se cambia y debe ser la misma en los tres backends.
CLAVE_INTERNA=cambiar-esta-clave-interna
CORS_ORIGINS=["http://localhost:5173"]
